Options -Indexes
Options -ExecCGI

# Block direct access to includes
<FilesMatch "\.(sql|log|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Custom error pages
ErrorDocument 403 /GROUP1_INS328201/vinamilk/pages/403.php

# PHP settings
php_value session.use_strict_mode 1
php_value session.cookie_httponly 1
